# ============================================================
# Campus Officer 环境变量示例
# 复制为 .env 后按实际情况填写：
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# ⚠️ 警告：.env 已被 .gitignore 排除，切勿把真实 Key 提交到仓库。
# ============================================================

# ------------------------------------------------------------
# 1) 模型服务（三选一，系统按 LLM_PROVIDER 自动选择）
# ------------------------------------------------------------

# 可选值： bailian | ollama | mock
#   bailian = 阿里云百炼（OpenAI 兼容接口，需 API Key）
#   ollama  = 本地 Ollama（无需 Key，需本机已拉取模型）
#   mock    = 纯规则降级引擎（无需任何网络与 Key，保证演示不中断）
LLM_PROVIDER=bailian

# --- 阿里云百炼 ---
# Key 获取地址：https://bailian.console.aliyun.com/  →  密钥管理
DASHSCOPE_API_KEY=sk-在这里填入你的百炼_API_Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# --- 本地 Ollama（LLM_PROVIDER=ollama 时生效） ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
# Ollama 默认不校验 Key，保留空字符串即可
OLLAMA_API_KEY=

# ------------------------------------------------------------
# 2) 业务后端与检索
# ------------------------------------------------------------

# 自建教务业务 API 地址（由 start.bat / start.sh 自动拉起）
CAMPUS_API_BASE_URL=http://127.0.0.1:8811

# 校规知识库目录（相对项目根目录）
KNOWLEDGE_DIR=knowledge/policies

# 产出物输出目录（Agent 只能写入此目录）
OUTPUT_DIR=outputs

# 会话数据库路径
SESSION_DB=data/sessions.db

# ------------------------------------------------------------
# 3) 学校信息源（日程同步）
# ------------------------------------------------------------

# 日程页的「🔄 同步官网」会抓取杉达学院官网（news.sandau.edu.cn）的
# 最新通知 / 讲座 / 校园活动，真实浏览器渲染（Playwright + 系统 Edge）绕过反爬。
# 依赖：系统已安装 Edge 浏览器 + 联网。已同步数据会持久化到本地数据库。
# 无需额外配置，直接点击界面上的「同步官网」按钮即可。

# ------------------------------------------------------------
# 4) 运行参数
# ------------------------------------------------------------

# Streamlit 端口
APP_PORT=8501

# 演示模式：1 = 放宽写入限制（仅本地演示用），0 = 严格模式
# 严格模式下 Agent 仍只能写 outputs/ 目录
DEMO_MODE=1

# 单次会话最大工具调用轮数（防止死循环）
MAX_TOOL_ROUNDS=8
